{
  "uid": "tem-pad-mac-network",
  "title": "tem-pad / Mac Network",
  "description": "Little Snitch を中心とした Mac の外部通信",
  "tags": [
    "tem-pad",
    "little-snitch"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "host",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "tem-pad-loki"
        },
        "query": {
          "label": "host",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "type": 1
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/tem-pad-overview"
    },
    {
      "title": "AI Agent",
      "type": "link",
      "url": "/d/tem-pad-ai-agent"
    },
    {
      "title": "Mac Network",
      "type": "link",
      "url": "/d/tem-pad-mac-network"
    },
    {
      "title": "Tailscale",
      "type": "link",
      "url": "/d/tem-pad-tailscale"
    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "Little Snitch 通信 (decision 別)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "tem-pad-loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "tem-pad-loki"
          },
          "expr": "sum by (decision) (count_over_time({source=\"little-snitch\", host=~\"$host\"}[$__interval]))",
          "legendFormat": "{{decision}}",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "table",
      "title": "process × remote host",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "tem-pad-loki"
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "tem-pad-loki"
          },
          "expr": "topk(50, sum by (process, remote_host, decision) (count_over_time({source=\"little-snitch\", host=~\"$host\"} | json | label_format process=payload_process, remote_host=payload_remote_host [$__range])))",
          "queryType": "instant",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "送信バイト数 (process 別)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "tem-pad-loki"
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "tem-pad-loki"
          },
          "expr": "topk(30, sum by (process) (sum_over_time({source=\"little-snitch\", host=~\"$host\"} | json | label_format process=payload_process | unwrap payload_bytes_out [$__range])))",
          "queryType": "instant",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ]
    },
    {
      "type": "logs",
      "title": "接続一覧 (process / host / IP / port / bytes / decision)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "tem-pad-loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "tem-pad-loki"
          },
          "expr": "{source=\"little-snitch\", host=~\"$host\"} | json | line_format \"{{.payload_process}} -> {{.payload_remote_host}} {{.payload_remote_ip}}:{{.payload_port}}/{{.payload_protocol}} out={{.payload_bytes_out}} in={{.payload_bytes_in}} [{{.decision}}]\"",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Docker / Claude / Codex 関連プロセスの通信",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "tem-pad-loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "tem-pad-loki"
          },
          "expr": "{source=\"little-snitch\", host=~\"$host\"} | json | payload_process=~\"(?i).*(docker|claude|codex|com\\\\.docker).*\" | line_format \"{{.payload_process}} -> {{.payload_remote_host}}:{{.payload_port}} [{{.decision}}]\"",
          "queryType": "range"
        }
      ]
    }
  ]
}
