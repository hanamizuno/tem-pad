{
  "uid": "tem-pad-tailscale",
  "title": "tem-pad / Tailscale",
  "description": "Tailnet の device / 設定 / policy 変更",
  "tags": [
    "tem-pad",
    "tailscale"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "host",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "tem-pad-loki"
        },
        "query": {
          "label": "host",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "type": 1
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/tem-pad-overview"
    },
    {
      "title": "AI Agent",
      "type": "link",
      "url": "/d/tem-pad-ai-agent"
    },
    {
      "title": "Mac Network",
      "type": "link",
      "url": "/d/tem-pad-mac-network"
    },
    {
      "title": "Tailscale",
      "type": "link",
      "url": "/d/tem-pad-tailscale"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "device 追加",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "tem-pad-loki"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "tem-pad-loki"
          },
          "expr": "sum(count_over_time({source=\"tailscale\", kind=\"device_added\", host=~\"$host\"}[$__range]))",
          "queryType": "instant",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "device 削除",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "tem-pad-loki"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "tem-pad-loki"
          },
          "expr": "sum(count_over_time({source=\"tailscale\", kind=\"device_removed\", host=~\"$host\"}[$__range]))",
          "queryType": "instant",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "policy 変更",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "tem-pad-loki"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "tem-pad-loki"
          },
          "expr": "sum(count_over_time({source=\"tailscale\", kind=\"audit_policy\", host=~\"$host\"}[$__range]))",
          "queryType": "instant",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "key / credential 変更",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "tem-pad-loki"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "tem-pad-loki"
          },
          "expr": "sum(count_over_time({source=\"tailscale\", kind=\"audit_key\", host=~\"$host\"}[$__range]))",
          "queryType": "instant",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "監査イベント (kind 別)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "tem-pad-loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "tem-pad-loki"
          },
          "expr": "sum by (kind) (count_over_time({source=\"tailscale\", host=~\"$host\"}[$__interval]))",
          "legendFormat": "{{kind}}",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "logs",
      "title": "device 変更 (added / removed / changed)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "tem-pad-loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "tem-pad-loki"
          },
          "expr": "{source=\"tailscale\", kind=~\"device_.*\", host=~\"$host\"} | json | line_format \"{{.kind}} {{.payload_device_name}} ({{.payload_os}}, user={{.payload_user}}, authorized={{.payload_authorized}}) {{.payload_changes}}\"",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "logs",
      "title": "設定変更 (audit log)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "tem-pad-loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "tem-pad-loki"
          },
          "expr": "{source=\"tailscale\", kind=~\"audit_.*\", host=~\"$host\"} | json | line_format \"{{.actor}} {{.action}} {{.payload_target_type}}:{{.payload_target_name}} {{.payload_target_property}} {{.payload_old}} -> {{.payload_new}} (origin={{.payload_origin}})\"",
          "queryType": "range"
        }
      ]
    }
  ]
}
