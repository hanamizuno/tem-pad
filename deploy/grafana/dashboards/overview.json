{
  "uid": "tem-pad-overview",
  "title": "tem-pad / Overview",
  "description": "過去 24 時間の横断ビュー",
  "tags": [
    "tem-pad",
    "overview"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "host",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "tem-pad-loki"
        },
        "query": {
          "label": "host",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "type": 1
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
