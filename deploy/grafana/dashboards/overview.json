      "datasource": {
        "type": "loki",
        "uid": "tem-pad-loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "tem-pad-loki"
          },
          "expr": "{source=~\".+\", host=~\"$host\"} | json | decision=\"deny\" or kind=~\"device_added|audit_policy|audit_key|agent_write\" or payload_reason_missing=\"true\"",
          "queryType": "range"
        }
      ]
    },
