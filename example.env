# docker compose 用の環境変数。`cp example.env .env` でコピーしてから値を書き換える。
# .env は .gitignore 済み。この example ファイルには secret を書かないこと。

# Grafana 管理者の初期ユーザー名とパスワード (初回起動時のみ反映。以降は Grafana 上で変更できる)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-first-start

# Tailscale Serve 経由で開く場合の公開 URL (任意)
# GRAFANA_ROOT_URL=https://mac-studio.example.ts.net/
