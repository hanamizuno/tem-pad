# docker compose 用の環境変数。`cp example.env .env` して値を書き換える。
# .env は .gitignore 済み。secret をこの example ファイルに書かないこと。

# Grafana 管理者の初期パスワード (初回起動時に反映。以降は Grafana 側で変更可)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-first-start

# Tailscale Serve 経由で開く場合の公開 URL (任意)
# GRAFANA_ROOT_URL=https://mac-studio.example.ts.net/
